<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Product Catalog</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-content">
            <a class="brand" asp-controller="Products" asp-action="Index">Product Catalog</a>
            <nav>
                <a asp-controller="Products" asp-action="Index">Products</a>
                <a asp-controller="Products" asp-action="Index" asp-route-category="Electronics">Electronics</a>
                <a asp-controller="Products" asp-action="Index" asp-route-category="Hardware">Hardware</a>
                <a asp-controller="Products" asp-action="Index" asp-route-category="Home Appliances">Home Appliances</a>
                <a class="button" asp-controller="Products" asp-action="Create">+ Add Product</a>
            </nav>
        </div>
    </header>
    <main class="container">@RenderBody()</main>
    <footer class="site-footer">ASP.NET Core MVC Product Catalog</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
