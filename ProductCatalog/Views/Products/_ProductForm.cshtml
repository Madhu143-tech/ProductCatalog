@model ProductCatalog.Models.Product
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<div class="form-grid">
    <div class="field">
        <label asp-for="Name"></label>
        <input asp-for="Name" placeholder="e.g. Bluetooth Speaker" />
        <span asp-validation-for="Name"></span>
    </div>
    <div class="field">
        <label asp-for="Category"></label>
        <input asp-for="Category" list="category-options" placeholder="Select or enter category" />
        <datalist id="category-options">
            <option>Electronics</option>
            <option>Hardware</option>
            <option>Home Appliances</option>
            <option>Accessories</option>
        </datalist>
        <span asp-validation-for="Category"></span>
    </div>
    <div class="field">
        <label asp-for="Price"></label>
        <div class="input-prefix"><span>₹</span><input asp-for="Price" type="number" step="0.01" /></div>
        <span asp-validation-for="Price"></span>
    </div>
    <div class="field">
        <label asp-for="Stock"></label>
        <input asp-for="Stock" type="number" />
        <span asp-validation-for="Stock"></span>
    </div>
    <div class="field field-wide">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" rows="5" placeholder="Enter product description"></textarea>
        <span asp-validation-for="Description"></span>
    </div>
    <label class="check-field"><input asp-for="IsFeatured" /><span>Featured Product</span></label>
</div>
