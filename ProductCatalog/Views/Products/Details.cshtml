@model ProductCatalog.Models.Product
@{ ViewData["Title"] = "Product Details"; }

<div class="page-heading">
    <div><h1>Product Details</h1><p>View selected product information.</p></div>
    <a class="button" asp-action="Index">Back to List</a>
</div>

<div class="details-card">
    <dl>
        <dt>Product Id</dt><dd>@Model.Id</dd>
        <dt>Product Name</dt><dd>@Model.Name</dd>
        <dt>Category</dt><dd>@Model.Category</dd>
        <dt>Description</dt><dd>@Model.Description</dd>
        <dt>Price</dt><dd>@Model.Price.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</dd>
        <dt>Stock Quantity</dt><dd>@Model.Stock</dd>
        <dt>Featured</dt><dd>@(Model.IsFeatured ? "Yes" : "No")</dd>
    </dl>
    <div class="form-actions">
        <a class="button button-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit Product</a>
        <a class="button button-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete Product</a>
    </div>
</div>
