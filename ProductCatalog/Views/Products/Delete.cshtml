@model ProductCatalog.Models.Product
@{ViewData["Title"]="Remove "+Model.Name;}
<div class="page-shell form-page"><a class="back-link" asp-action="Details" asp-route-id="@Model.Id">← Back to product</a><div class="delete-card"><div class="eyebrow"><span class="eyebrow-line"></span> REMOVE FROM COLLECTION</div><h1>Let this one <em>go?</em></h1><p>You're about to remove <strong>@Model.Name</strong> from your catalog. This can't be undone.</p><div class="delete-actions"><a class="button button-outline" asp-action="Details" asp-route-id="@Model.Id">Keep product</a><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button class="button button-danger" type="submit">Remove product</button></form></div></div></div>
