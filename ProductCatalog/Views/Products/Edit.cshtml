@model ProductCatalog.Models.Product
@{ViewData["Title"]="Edit "+Model.Name;}
<div class="page-shell form-page"><a class="back-link" asp-action="Details" asp-route-id="@Model.Id">← Back to @Model.Name</a><div class="form-heading"><div class="eyebrow"><span class="eyebrow-line"></span> REFINE THE DETAILS</div><h1>Make it <em>yours.</em></h1><p>Update the details of @Model.Name.</p></div><form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="product-form"><input type="hidden" asp-for="Id"/><partial name="_ProductForm" model="Model"/><div class="form-actions"><a class="button button-outline" asp-action="Details" asp-route-id="@Model.Id">Cancel</a><button class="button button-dark" type="submit">Save changes <span>↗</span></button></div></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
